<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SoftEther Japan</vendor>
  <vendor_url>https://github.com/nicomet49/softether-jp</vendor_url>
  <action id="net.vpngate.SoftEtherJapan.network">
    <description>Manage the SoftEther Japan tunnel network</description>
    <message>Authentication is required to manage the SoftEther Japan tunnel</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/softether-jp-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
